coroutine.wrap(function()
    local UIS = game:GetService('UserInputService')
    local dragging = false
    local dragStart = nil
    local startPos = nil

    local function updateDrag(input)
        local delta = input.Position - dragStart
        DragFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

    DragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = DragFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    local lastInput = nil
    DragFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            lastInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input == lastInput and dragging then
            updateDrag(input)
        end
    end)
end)()

coroutine.wrap(function()
    local TweenService = game:GetService('TweenService')
    local tweenTime = 0.2
    local originalBG = CloseFrame.Parent.BackgroundColor3
    local originalText = CloseBtn.TextColor3
    local activeTweens = {}

    local function createTweens(bgColor, textColor)
        local info = TweenInfo.new(tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        return {
            TweenService:Create(CloseFrame.Parent, info, {BackgroundColor3 = bgColor}),
            TweenService:Create(CloseBtn, info, {TextColor3 = textColor}),
        }
    end

    CloseBtn.MouseEnter:Connect(function()
        for _, t in pairs(activeTweens) do t:Cancel() end
        activeTweens = createTweens(Color3.fromRGB(255, 0, 0), Color3.new(1, 1, 1))
        for _, t in pairs(activeTweens) do t:Play() end
    end)

    CloseBtn.MouseLeave:Connect(function()
        for _, t in pairs(activeTweens) do t:Cancel() end
        activeTweens = createTweens(originalBG, originalText)
        for _, t in pairs(activeTweens) do t:Play() end
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        DragFrame.Visible = false
        ToggleBtn.Visible = true
    end)
end)()

coroutine.wrap(function()
    local TweenService = game:GetService('TweenService')
    local tweenTime = 0.2
    local minimized = true
    local originalBG = MinFrame.Parent.BackgroundColor3
    local activeTweens = {}

    local function createTweens(bgColor)
        local info = TweenInfo.new(tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        return {TweenService:Create(MinFrame.Parent, info, {BackgroundColor3 = bgColor})}
    end

    MinBtn.MouseEnter:Connect(function()
        for _, t in pairs(activeTweens) do t:Cancel() end
        activeTweens = createTweens(Color3.fromRGB(193, 193, 193))
        for _, t in pairs(activeTweens) do t:Play() end
    end)

    MinBtn.MouseLeave:Connect(function()
        for _, t in pairs(activeTweens) do t:Cancel() end
        activeTweens = createTweens(originalBG)
        for _, t in pairs(activeTweens) do t:Play() end
    end)

    MinBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = minimized
        minimized = not minimized
    end)
end)()

